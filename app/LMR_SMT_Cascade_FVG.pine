//@version=6
indicator("LMR SMT - Time Cascade + Displacement FVG", overlay = true, max_lines_count = 300, max_labels_count = 400, max_boxes_count = 200)

// =====================================================================
// LMR SMT - TIME CASCADE + DISPLACEMENT FVG
// -----------------------------------------------------------------------
// TIME SMT (only):  1m 5m 15m 30m 1hr 90m Daily.
//   For each timeframe: did NQ/ES/YM disagree on taking the PRIOR period's
//   high/low? One asset takes it, another fails = SMT.
//
// CHRONOLOGICAL CASCADE:  an SMT is only VALID if a HIGHER-timeframe SMT
//   sits above it (same direction). Daily is the top anchor. A lone
//   lower-TF SMT with no HTF above it is NOT valid.
//
// DISPLACEMENT FVG:  a 3-candle fair value gap whose displacement leg
//   BREAKS STRUCTURE (takes out the prior swing high/low). Its edge is the
//   potential high/low.
//
// NOTE: Pine can only look UP a timeframe. View the 1m chart to see the
//   whole 1D->1m cascade; on higher charts the lower rungs show "n/a".
// request.security budget: 7 TFs x 3 assets = 21. Memory-safe.
// =====================================================================

grpSym = "Symbols"
nqSymbol = input.symbol("NQ1!", "NQ", inline = "nq", group = grpSym)
useNQ    = input.bool(true, "compare", inline = "nq", group = grpSym)
esSymbol = input.symbol("ES1!", "ES", inline = "es", group = grpSym)
useES    = input.bool(true, "compare", inline = "es", group = grpSym)
ymSymbol = input.symbol("YM1!", "YM", inline = "ym", group = grpSym)
useYM    = input.bool(true, "compare", inline = "ym", group = grpSym)

grpSMT = "Time SMT Cascade"
tfLookback = input.int(10, "Sweep = break of the last N periods' high/low (per TF)", minval = 1, group = grpSMT)
requireHTF = input.bool(true, "Only CONFIRMED SMT (needs a higher-TF SMT above)", group = grpSMT)
smtColor   = input.color(color.new(#FFA500, 0), "SMT line color", group = grpSMT)
lineWidth  = input.int(2, "Line width", minval = 1, maxval = 5, group = grpSMT)
labelSize  = input.string(size.small, "Label size", options = [size.tiny, size.small, size.normal], group = grpSMT)
labelTxt   = input.color(color.black, "Label text", inline = "lb", group = grpSMT)
labelBg    = input.color(color.new(color.gray, 60), "Label bg", inline = "lb", group = grpSMT)

grpFVG = "Displacement FVG"
useFVG     = input.bool(false, "Show Displacement FVG (breaks structure)", group = grpFVG)
strLen     = input.int(10, "Structure-break lookback (bars)", minval = 2, group = grpFVG)
bullFVGcol = input.color(color.new(color.teal, 82), "Bullish FVG", group = grpFVG)
bearFVGcol = input.color(color.new(color.red, 82), "Bearish FVG", group = grpFVG)
fvgExtend  = input.int(20, "FVG box extend (bars)", minval = 1, group = grpFVG)
fvgRealtime = input.bool(false, "FVG real-time (draw before bar close - may repaint)", group = grpFVG)

grpRange = "Dealing Range"
useRange     = input.bool(false, "Use Dealing Range (draw + filter SMT to it)", group = grpRange)
rangeStepsUp = input.int(3, "Dealing Range = chart TF + N steps up (auto HTF)", minval = 1, maxval = 6, group = grpRange)
rangeTolTk   = input.int(20, "SMT-at-boundary tolerance (ticks)", minval = 0, group = grpRange)
htfCol     = input.color(color.new(color.blue, 0), "Range color", group = grpRange)

grpTable = "Display"
showTable = input.bool(true, "Show cascade table", group = grpTable)

// ---------------------------------------------------------------------
// HELPERS
// ---------------------------------------------------------------------
// SMT among ENABLED assets only: >=2 compared and they DISAGREE.
f_eval3(nqF, esF, ymF) =>
    cnt = (useNQ ? 1 : 0) + (useES ? 1 : 0) + (useYM ? 1 : 0)
    tc  = (useNQ and nqF ? 1 : 0) + (useES and esF ? 1 : 0) + (useYM and ymF ? 1 : 0)
    cnt >= 2 and tc > 0 and tc < cnt

// chart period high/low + exact wick times (this period + prior period)
f_periodTrack(isNew) =>
    var float cH=na
    var int   cHt=na
    var float cL=na
    var int   cLt=na
    var float pH=na
    var int   pHt=na
    var float pL=na
    var int   pLt=na
    if isNew
        pH := cH
        pHt := cHt
        pL := cL
        pLt := cLt
        cH := high
        cHt := time
        cL := low
        cLt := time
    else
        if na(cH) or high > cH
            cH := high
            cHt := time
        if na(cL) or low < cL
            cL := low
            cLt := time
    [cH, cHt, cL, cLt, pH, pHt, pL, pLt]

// per-TF SMT flags: did they disagree taking the prior period high / low?
f_smt(nqH, nqHP, nqL, nqLP, esH, esHP, esL, esLP, ymH, ymHP, ymL, ymLP) =>
    nqSH = not na(nqHP) and nqH > nqHP
    esSH = not na(esHP) and esH > esHP
    ymSH = not na(ymHP) and ymH > ymHP
    nqSL = not na(nqLP) and nqL < nqLP
    esSL = not na(esLP) and esL < esLP
    ymSL = not na(ymLP) and ymL < ymLP
    [f_eval3(nqSH, esSH, ymSH), f_eval3(nqSL, esSL, ymSL)]

chartMin = timeframe.isintraday ? timeframe.multiplier : timeframe.isdaily ? timeframe.multiplier * 1440 : timeframe.multiplier * 10080

// =====================================================================
// PER-TIMEFRAME LEVELS (ascending: 1m ... Daily)
// =====================================================================
// --- 1m ---
[nq1H,nq1L,nq1HP,nq1LP] = request.security(nqSymbol, "1", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[es1H,es1L,es1HP,es1LP] = request.security(esSymbol, "1", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[ym1H,ym1L,ym1HP,ym1LP] = request.security(ymSymbol, "1", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[smtH1, smtL1] = f_smt(nq1H,nq1HP,nq1L,nq1LP, es1H,es1HP,es1L,es1LP, ym1H,ym1HP,ym1L,ym1LP)
[c1H,c1Ht,c1L,c1Lt,p1H,p1Ht,p1L,p1Lt] = f_periodTrack(timeframe.change("1"))

// --- 5m ---
[nq5H,nq5L,nq5HP,nq5LP] = request.security(nqSymbol, "5", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[es5H,es5L,es5HP,es5LP] = request.security(esSymbol, "5", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[ym5H,ym5L,ym5HP,ym5LP] = request.security(ymSymbol, "5", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[smtH5, smtL5] = f_smt(nq5H,nq5HP,nq5L,nq5LP, es5H,es5HP,es5L,es5LP, ym5H,ym5HP,ym5L,ym5LP)
[c5H,c5Ht,c5L,c5Lt,p5H,p5Ht,p5L,p5Lt] = f_periodTrack(timeframe.change("5"))

// --- 15m ---
[nq15H,nq15L,nq15HP,nq15LP] = request.security(nqSymbol, "15", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[es15H,es15L,es15HP,es15LP] = request.security(esSymbol, "15", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[ym15H,ym15L,ym15HP,ym15LP] = request.security(ymSymbol, "15", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[smtH15, smtL15] = f_smt(nq15H,nq15HP,nq15L,nq15LP, es15H,es15HP,es15L,es15LP, ym15H,ym15HP,ym15L,ym15LP)
[c15H,c15Ht,c15L,c15Lt,p15H,p15Ht,p15L,p15Lt] = f_periodTrack(timeframe.change("15"))

// --- 30m ---
[nq30H,nq30L,nq30HP,nq30LP] = request.security(nqSymbol, "30", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[es30H,es30L,es30HP,es30LP] = request.security(esSymbol, "30", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[ym30H,ym30L,ym30HP,ym30LP] = request.security(ymSymbol, "30", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[smtH30, smtL30] = f_smt(nq30H,nq30HP,nq30L,nq30LP, es30H,es30HP,es30L,es30LP, ym30H,ym30HP,ym30L,ym30LP)
[c30H,c30Ht,c30L,c30Lt,p30H,p30Ht,p30L,p30Lt] = f_periodTrack(timeframe.change("30"))

// --- 1hr ---
[nq60H,nq60L,nq60HP,nq60LP] = request.security(nqSymbol, "60", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[es60H,es60L,es60HP,es60LP] = request.security(esSymbol, "60", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[ym60H,ym60L,ym60HP,ym60LP] = request.security(ymSymbol, "60", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[smtH60, smtL60] = f_smt(nq60H,nq60HP,nq60L,nq60LP, es60H,es60HP,es60L,es60LP, ym60H,ym60HP,ym60L,ym60LP)
[c60H,c60Ht,c60L,c60Lt,p60H,p60Ht,p60L,p60Lt] = f_periodTrack(timeframe.change("60"))

// --- 90m ---
[nq90H,nq90L,nq90HP,nq90LP] = request.security(nqSymbol, "90", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[es90H,es90L,es90HP,es90LP] = request.security(esSymbol, "90", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[ym90H,ym90L,ym90HP,ym90LP] = request.security(ymSymbol, "90", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[smtH90, smtL90] = f_smt(nq90H,nq90HP,nq90L,nq90LP, es90H,es90HP,es90L,es90LP, ym90H,ym90HP,ym90L,ym90LP)
[c90H,c90Ht,c90L,c90Lt,p90H,p90Ht,p90L,p90Lt] = f_periodTrack(timeframe.change("90"))

// --- Daily ---
[nqDH,nqDL,nqDHP,nqDLP] = request.security(nqSymbol, "D", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[esDH,esDL,esDHP,esDLP] = request.security(esSymbol, "D", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[ymDH,ymDL,ymDHP,ymDLP] = request.security(ymSymbol, "D", [high, low, ta.highest(high, tfLookback)[1], ta.lowest(low, tfLookback)[1]])
[smtHD, smtLD] = f_smt(nqDH,nqDHP,nqDL,nqDLP, esDH,esDHP,esDL,esDLP, ymDH,ymDHP,ymDL,ymDLP)
[cDH,cDHt,cDL,cDLt,pDH,pDHt,pDL,pDLt] = f_periodTrack(timeframe.change("D"))

// =====================================================================
// PACK LEVELS INTO ARRAYS (index 0 = 1m ... 6 = Daily)
// =====================================================================
lbls  = array.from("1m", "5m", "15m", "30m", "1hr", "90m", "Daily")
mins  = array.from(1, 5, 15, 30, 60, 90, 1440)
aSmtH = array.from(smtH1, smtH5, smtH15, smtH30, smtH60, smtH90, smtHD)
aSmtL = array.from(smtL1, smtL5, smtL15, smtL30, smtL60, smtL90, smtLD)
acH   = array.from(c1H, c5H, c15H, c30H, c60H, c90H, cDH)
acHt  = array.from(c1Ht, c5Ht, c15Ht, c30Ht, c60Ht, c90Ht, cDHt)
apH   = array.from(p1H, p5H, p15H, p30H, p60H, p90H, pDH)
apHt  = array.from(p1Ht, p5Ht, p15Ht, p30Ht, p60Ht, p90Ht, pDHt)
acL   = array.from(c1L, c5L, c15L, c30L, c60L, c90L, cDL)
acLt  = array.from(c1Lt, c5Lt, c15Lt, c30Lt, c60Lt, c90Lt, cDLt)
apL   = array.from(p1L, p5L, p15L, p30L, p60L, p90L, pDL)
apLt  = array.from(p1Lt, p5Lt, p15Lt, p30Lt, p60Lt, p90Lt, pDLt)

nLv = 7

// active = this TF is >= chart TF (Pine can only look up). Bounds-safe.
f_active(i) => i >= 0 and i < nLv ? array.get(mins, i) >= chartMin : false

// first-bar triggers per level (scalar series -> reliable one-shot drawing)
aTrigH = array.from(smtH1 and not smtH1[1], smtH5 and not smtH5[1], smtH15 and not smtH15[1], smtH30 and not smtH30[1], smtH60 and not smtH60[1], smtH90 and not smtH90[1], smtHD and not smtHD[1])
aTrigL = array.from(smtL1 and not smtL1[1], smtL5 and not smtL5[1], smtL15 and not smtL15[1], smtL30 and not smtL30[1], smtL60 and not smtL60[1], smtL90 and not smtL90[1], smtLD and not smtLD[1])

// =====================================================================
// DEALING RANGE = the chosen HTF's HIGH & LOW (its period high/low IS the
//   range - no swing pivots). We keep the current developing HTF period AND
//   the last completed HTF period as boundaries, then filter SMT to fire
//   only when its swept level sits ON one of those highs/lows.
// =====================================================================
rangeTol = rangeTolTk * syminfo.mintick
// auto HTF: step the chart TF up the ladder (1m 5m 15m 30m 1hr 90m Daily)
chartIdx = chartMin <= 1 ? 0 : chartMin <= 5 ? 1 : chartMin <= 15 ? 2 : chartMin <= 30 ? 3 : chartMin <= 60 ? 4 : chartMin <= 90 ? 5 : 6
rIdx = math.min(chartIdx + rangeStepsUp, 6)
rangeTF = rIdx == 0 ? "1" : rIdx == 1 ? "5" : rIdx == 2 ? "15" : rIdx == 3 ? "30" : rIdx == 4 ? "60" : rIdx == 5 ? "90" : "D"
[rHiCur, rLoCur, rHiPrev, rLoPrev] = request.security(syminfo.tickerid, rangeTF, [high, low, high[1], low[1]])

f_atHigh(px) =>
    not na(px) and ((not na(rHiCur) and math.abs(px - rHiCur) <= rangeTol) or (not na(rHiPrev) and math.abs(px - rHiPrev) <= rangeTol))
f_atLow(px) =>
    not na(px) and ((not na(rLoCur) and math.abs(px - rLoCur) <= rangeTol) or (not na(rLoPrev) and math.abs(px - rLoPrev) <= rangeTol))

// =====================================================================
// CASCADE + DRAW  (top-down; first bar of each SMT; invalidates on revisit)
// =====================================================================
var array<line>  smtLn  = array.new<line>()
var array<label> smtLb  = array.new<label>()
var array<float> smtLvl = array.new_float()
var array<bool>  smtHi  = array.new_bool()

firedH = false
firedL = false
for i = 0 to nLv - 1
    if f_active(i)
        // is there a HIGHER active TF with the same-direction SMT right now?
        ah = false
        al = false
        if i < nLv - 1
            for j = i + 1 to nLv - 1
                if f_active(j)
                    ah := ah or array.get(aSmtH, j)
                    al := al or array.get(aSmtL, j)
        isTop = i == nLv - 1
        validH = array.get(aSmtH, i) and (isTop or ah)
        validL = array.get(aSmtL, i) and (isTop or al)
        showH = array.get(aTrigH, i) and (not requireHTF or validH) and (not useRange or f_atHigh(array.get(apH, i)))
        showL = array.get(aTrigL, i) and (not requireHTF or validL) and (not useRange or f_atLow(array.get(apL, i)))
        if showH and not na(array.get(apH, i)) and not na(array.get(acH, i))
            lnH = line.new(array.get(apHt, i), array.get(apH, i), array.get(acHt, i), array.get(acH, i), xloc = xloc.bar_time, color = smtColor, width = lineWidth)
            lbH = label.new(array.get(acHt, i), array.get(acH, i), array.get(lbls, i) + (validH ? " SMT✓▼" : " SMT▼"), xloc = xloc.bar_time, style = label.style_label_down, color = labelBg, textcolor = labelTxt, size = labelSize)
            array.push(smtLn, lnH)
            array.push(smtLb, lbH)
            array.push(smtLvl, array.get(acH, i))
            array.push(smtHi, true)
            firedH := true
        if showL and not na(array.get(apL, i)) and not na(array.get(acL, i))
            lnL = line.new(array.get(apLt, i), array.get(apL, i), array.get(acLt, i), array.get(acL, i), xloc = xloc.bar_time, color = smtColor, width = lineWidth)
            lbL = label.new(array.get(acLt, i), array.get(acL, i), array.get(lbls, i) + (validL ? " SMT✓▲" : " SMT▲"), xloc = xloc.bar_time, style = label.style_label_up, color = labelBg, textcolor = labelTxt, size = labelSize)
            array.push(smtLn, lnL)
            array.push(smtLb, lbL)
            array.push(smtLvl, array.get(acL, i))
            array.push(smtHi, false)
            firedL := true

// SMT INVALIDATION: once price returns to an SMT's level it is mitigated ->
// delete it. Only the recent, un-touched SMT stays on the chart.
kk = array.size(smtLn) - 1
while kk >= 0
    lvl = array.get(smtLvl, kk)
    gone = array.get(smtHi, kk) ? high > lvl : low < lvl
    if gone
        line.delete(array.get(smtLn, kk))
        label.delete(array.get(smtLb, kk))
        array.remove(smtLn, kk)
        array.remove(smtLb, kk)
        array.remove(smtLvl, kk)
        array.remove(smtHi, kk)
    kk := kk - 1
while array.size(smtLn) > 100
    line.delete(array.get(smtLn, 0))
    label.delete(array.get(smtLb, 0))
    array.shift(smtLn)
    array.shift(smtLb)
    array.shift(smtLvl)
    array.shift(smtHi)

// =====================================================================
// DISPLACEMENT FVG  (5m+ only; sweep + displacement)
//   Bullish: the prior DOWN-close candle's low is swept, then price
//     displaces up leaving a 3-candle FVG.
//   Bearish: the prior UP-close candle's high is swept, then displaces
//     down leaving a 3-candle FVG.
// =====================================================================
fvgGate  = useFVG and chartMin >= 5 and (fvgRealtime or barstate.isconfirmed)
bullFVG  = low > high[2]
bearFVG  = high < low[2]
dispBull = fvgGate and bullFVG and (close[2] < open[2]) and (low[1] < low[2])
dispBear = fvgGate and bearFVG and (close[2] > open[2]) and (high[1] > high[2])
barMs  = time - time[1]
rightT = time + fvgExtend * barMs
if dispBull
    box.new(time[2], low, rightT, high[2], xloc = xloc.bar_time, bgcolor = bullFVGcol, border_color = color.new(color.teal, 40))
    label.new(time[1], low[2], "Disp FVG ▲", xloc = xloc.bar_time, style = label.style_none, textcolor = color.teal, size = size.tiny)
if dispBear
    box.new(time[2], low[2], rightT, high, xloc = xloc.bar_time, bgcolor = bearFVGcol, border_color = color.new(color.red, 40))
    label.new(time[1], high[2], "Disp FVG ▼", xloc = xloc.bar_time, style = label.style_none, textcolor = color.red, size = size.tiny)

// =====================================================================
// REAL-TIME ALERTS
// =====================================================================
alertcondition(firedH,   title = "SMT High (cascade)", message = "LMR SMT: bearish time-SMT confirmed")
alertcondition(firedL,   title = "SMT Low (cascade)",  message = "LMR SMT: bullish time-SMT confirmed")
alertcondition(firedH or firedL, title = "SMT Any", message = "LMR SMT: time-SMT confirmed")
alertcondition(dispBull, title = "Displacement FVG Bull", message = "LMR: bullish displacement FVG")
alertcondition(dispBear, title = "Displacement FVG Bear", message = "LMR: bearish displacement FVG")

// =====================================================================
// DRAW DEALING-RANGE (light): HTF current high/low (solid dotted) + last
// completed HTF high/low (fainter). Thin, dotted, extended right.
// =====================================================================
var array<line> dLines = array.new<line>()
if barstate.islast
    // always clear old range lines (so turning the range OFF removes them)
    if array.size(dLines) > 0
        for ln in dLines
            line.delete(ln)
        array.clear(dLines)
if useRange and barstate.islast
    lt = time[20]
    if not na(rHiCur)
        array.push(dLines, line.new(lt, rHiCur, time, rHiCur, xloc = xloc.bar_time, color = htfCol, width = 1, style = line.style_dotted, extend = extend.right))
    if not na(rLoCur)
        array.push(dLines, line.new(lt, rLoCur, time, rLoCur, xloc = xloc.bar_time, color = htfCol, width = 1, style = line.style_dotted, extend = extend.right))
    if not na(rHiPrev)
        array.push(dLines, line.new(lt, rHiPrev, time, rHiPrev, xloc = xloc.bar_time, color = color.new(htfCol, 65), width = 1, style = line.style_dotted, extend = extend.right))
    if not na(rLoPrev)
        array.push(dLines, line.new(lt, rLoPrev, time, rLoPrev, xloc = xloc.bar_time, color = color.new(htfCol, 65), width = 1, style = line.style_dotted, extend = extend.right))

// =====================================================================
// CASCADE TABLE (top-down)
// =====================================================================
if showTable and barstate.islast
    tbl = table.new(position.top_right, 3, nLv + 2, bgcolor = color.new(color.black, 10), border_color = color.gray, border_width = 1)
    table.cell(tbl, 0, 0, "TF", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(tbl, 1, 0, "High SMT", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(tbl, 2, 0, "Low SMT", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    for i = 0 to nLv - 1
        rowIdx = nLv - i   // Daily (i=6) -> row 1 at top, 1m (i=0) -> row 7
        act = f_active(i)
        ah = false
        al = false
        if i < nLv - 1
            for j = i + 1 to nLv - 1
                if f_active(j)
                    ah := ah or array.get(aSmtH, j)
                    al := al or array.get(aSmtL, j)
        isTop = i == nLv - 1
        vH = array.get(aSmtH, i) and (isTop or ah)
        vL = array.get(aSmtL, i) and (isTop or al)
        hTxt = not act ? "n/a" : array.get(aSmtH, i) ? (vH ? "✓ CONF" : "• raw") : "-"
        lTxt = not act ? "n/a" : array.get(aSmtL, i) ? (vL ? "✓ CONF" : "• raw") : "-"
        hCol = not act ? color.gray : array.get(aSmtH, i) ? (vH ? color.lime : color.orange) : color.gray
        lCol = not act ? color.gray : array.get(aSmtL, i) ? (vL ? color.lime : color.orange) : color.gray
        table.cell(tbl, 0, rowIdx, array.get(lbls, i), text_color = color.white, text_size = size.small)
        table.cell(tbl, 1, rowIdx, hTxt, text_color = hCol, text_size = size.small)
        table.cell(tbl, 2, rowIdx, lTxt, text_color = lCol, text_size = size.small)
    table.cell(tbl, 0, nLv + 1, "Range " + rangeTF, text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, nLv + 1, "✓ = HTF confirmed", text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 2, nLv + 1, "top-down", text_color = color.gray, text_size = size.tiny)
