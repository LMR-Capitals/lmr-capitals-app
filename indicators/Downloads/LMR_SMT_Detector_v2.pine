//@version=6
indicator("LMR SMT Detector v2 (Focal Framework)", overlay=true, max_lines_count=200, max_labels_count=200)

// =====================================================================
// LMR SMT DETECTOR v2 - built on your own Focal Point framework
// -----------------------------------------------------------------------
// Compares NQ, ES and YM directly (not "chart vs compare symbol") across
// every level you described:
//
//   FOCAL POINT HIGHS/LOWS - did all three take out the PRIOR period's
//   high/low, or did one fail?
//     - Monthly / Weekly / Daily (standard HTF candles)
//     - 90-Min Block  (your LMR quarter - A/M/D block high/low)
//     - Session       (Asia/London/NY AM/NY PM outer session high/low)
//
//   INTRADAY MULTI-TIMEFRAME SMT - same "did all three confirm the last
//   candle's HH/LL" check, run separately at 90m/60m/15m/5m/1m
//
//   RE-DISTRIBUTION SMT - after a Distribution leg, did all three
//   retrace into the same 50%-75% zone of their own leg, or did one
//   fail to reach it (or blow through it)?
//
//   FVG SMT - the first FVG formed in a Distribution leg: did all three
//   get that gap filled, or did one fail to trade back into it?
//
// AMD CONFIRMATION GATE - every SMT flag above is a raw structural
// observation. It's only marked CONFIRMED when the chart's own symbol
// is showing an actual Distribution leg (same 90-min AMD engine from
// the other two indicators). Toggle this off if you want to see raw
// divergences regardless of AMD state.
//
// SCOPE NOTE: this is a large, first-pass build across everything you
// described. Flag anything that doesn't line up with how you actually
// define a level and I'll adjust the specific piece.
// =====================================================================

// ---------------------------------------------------------------------
// INPUTS
// ---------------------------------------------------------------------
grpSym = "Symbols"
nqSymbol = input.symbol("NQ1!", "NQ", inline = "sym", group = grpSym)
esSymbol = input.symbol("ES1!", "ES", inline = "sym", group = grpSym)
ymSymbol = input.symbol("YM1!", "YM", inline = "sym", group = grpSym)

grpFocal = "Focal Point Levels"
useMonthly = input.bool(true, "Monthly", inline = "f1", group = grpFocal)
useWeekly  = input.bool(true, "Weekly",  inline = "f1", group = grpFocal)
useDaily   = input.bool(true, "Daily",   inline = "f2", group = grpFocal)
use90Block = input.bool(true, "90-Min Block", inline = "f2", group = grpFocal)
useSession = input.bool(true, "Session", group = grpFocal)

grpIntra = "Intraday Timeframe SMT"
useIntraday = input.bool(true, "Enable Intraday Multi-TF SMT", group = grpIntra)
tf1 = input.string("90", "TF 1 (minutes)", inline = "tfa", group = grpIntra)
tf2 = input.string("60", "TF 2 (minutes)", inline = "tfa", group = grpIntra)
tf3 = input.string("15", "TF 3 (minutes)", inline = "tfb", group = grpIntra)
tf4 = input.string("5",  "TF 4 (minutes)", inline = "tfb", group = grpIntra)
tf5 = input.string("1",  "TF 5 (minutes)", group = grpIntra)

grpRedis = "Re-Distribution (Retracement)"
useRedis  = input.bool(true,  "Enable Re-Distribution SMT", group = grpRedis)
redisLow  = input.float(0.5,  "Zone Start (0.5 = 50%)", inline = "rz", step = 0.05, group = grpRedis)
redisHigh = input.float(0.75, "Zone End (0.75 = 75%)",  inline = "rz", step = 0.05, group = grpRedis)

grpFVG = "FVG SMT"
useFVGSMT = input.bool(true, "Enable FVG SMT (fill status of first FVG in the leg)", group = grpFVG)

grpAMD = "AMD Confirmation Gate"
atrLen            = input.int(14,   "ATR Length", inline = "amd", group = grpAMD)
distMult          = input.float(0.8, "Displacement threshold (x ATR)", inline = "amd", group = grpAMD)
requireAMDConfirm = input.bool(true, "Only mark rows CONFIRMED when chart symbol shows AMD Distribution", group = grpAMD)

grpVis = "Display"
showTable = input.bool(true, "Show SMT Table", group = grpVis)
bullColor = input.color(color.lime, "Aligned Color",   inline = "vc", group = grpVis)
bearColor = input.color(color.red,  "Divergent Color", inline = "vc", group = grpVis)

// ---------------------------------------------------------------------
// SHARED ENGINE - session/block/True Open/Distribution/FVG state,
// callable directly (chart symbol) or wrapped in request.security
// (NQ/ES/YM), each instance keeping its own independent state.
// ---------------------------------------------------------------------
f_sessionBlockState(distMultParam) =>
    nyH = hour(time, "America/New_York")
    nyM = minute(time, "America/New_York")
    nyMin = nyH * 60 + nyM

    string bID = na
    string sName = na
    string rl = na
    if nyMin >= 1080 or nyMin < 150
        bID := "ASIA"
        sName := "Asia"
        rl := "N"
    else if nyMin >= 960 and nyMin < 1080
        bID := "OFF"
        sName := "Off"
        rl := "N"
    else if nyMin >= 150 and nyMin < 240
        bID := "LO1"
        sName := "London"
        rl := "A"
    else if nyMin >= 240 and nyMin < 330
        bID := "LO2"
        sName := "London"
        rl := "M"
    else if nyMin >= 330 and nyMin < 420
        bID := "LO3"
        sName := "London"
        rl := "D"
    else if nyMin >= 420 and nyMin < 510
        bID := "AM1"
        sName := "NY AM"
        rl := "A"
    else if nyMin >= 510 and nyMin < 600
        bID := "AM2"
        sName := "NY AM"
        rl := "M"
    else if nyMin >= 600 and nyMin < 690
        bID := "AM3"
        sName := "NY AM"
        rl := "D"
    else if nyMin >= 690 and nyMin < 780
        bID := "PM1"
        sName := "NY PM"
        rl := "A"
    else if nyMin >= 780 and nyMin < 870
        bID := "PM2"
        sName := "NY PM"
        rl := "M"
    else
        bID := "PM3"
        sName := "NY PM"
        rl := "D"

    isNewB = bID != bID[1]
    isNewS = sName != sName[1]

    var float bHigh       = na
    var float bLow        = na
    var float pbHigh      = na
    var float pbLow       = na
    var float sHigh       = na
    var float sLow        = na
    var float psHigh      = na
    var float psLow       = na
    var float trueOpen    = na
    var float distExtHigh = na
    var float distExtLow  = na
    var float fvgLevel    = na
    var bool  fvgFilled   = false

    if isNewS
        psHigh := sHigh
        psLow  := sLow
        sHigh  := high
        sLow   := low
    else
        sHigh := math.max(sHigh, high)
        sLow  := math.min(sLow, low)

    if isNewB
        pbHigh := bHigh
        pbLow  := bLow
        bHigh  := high
        bLow   := low
        if rl == "M"
            trueOpen    := open
            distExtHigh := na
            distExtLow  := na
            fvgLevel    := na
            fvgFilled   := false
    else
        bHigh := math.max(bHigh, high)
        bLow  := math.min(bLow, low)

    atrValSym = ta.atr(atrLen)
    isBullD = rl == "D" and not na(trueOpen) and (close - trueOpen) > atrValSym * distMultParam
    isBearD = rl == "D" and not na(trueOpen) and (close - trueOpen) < -atrValSym * distMultParam

    if rl == "D"
        distExtHigh := na(distExtHigh) ? high : math.max(distExtHigh, high)
        distExtLow  := na(distExtLow)  ? low  : math.min(distExtLow, low)

    bullFVGNow = low > high[2]
    bearFVGNow = high < low[2]

    if rl == "D" and isBullD and bullFVGNow and na(fvgLevel)
        fvgLevel  := low     // nearest edge of the up-gap; price returning down to here fills it
        fvgFilled := false

    if rl == "D" and isBearD and bearFVGNow and na(fvgLevel)
        fvgLevel  := high    // nearest edge of the down-gap; price returning up to here fills it
        fvgFilled := false

    if not na(fvgLevel) and not fvgFilled
        touchedZone = (isBullD and low <= fvgLevel) or (isBearD and high >= fvgLevel)
        if touchedZone
            fvgFilled := true

    [bHigh, bLow, pbHigh, pbLow, sHigh, sLow, psHigh, psLow, trueOpen, rl, isBullD, isBearD, distExtHigh, distExtLow, fvgLevel, fvgFilled, close]

// ---------------------------------------------------------------------
// 3-WAY DIVERGENCE CHECK
// ---------------------------------------------------------------------
f_eval3(a, b, c) =>
    not (a == b and b == c)

f_flagText(nqFlag, esFlag, ymFlag) =>
    (nqFlag ? "NQ✓ " : "NQ✗ ") + (esFlag ? "ES✓ " : "ES✗ ") + (ymFlag ? "YM✓" : "YM✗")

// ---------------------------------------------------------------------
// CHART SYMBOL - direct call, used purely as the AMD confirmation gate
// ---------------------------------------------------------------------
[chBH, chBL, chPBH, chPBL, chSH, chSL, chPSH, chPSL, chTO, chRole, chIsBullD, chIsBearD, chDistExtHigh, chDistExtLow, chFvgLevel, chFvgFilled, chClose] = f_sessionBlockState(distMult)

amdConfirmed  = chIsBullD or chIsBearD
amdDirection  = chIsBullD ? "Bullish" : chIsBearD ? "Bearish" : "-"
gatePass      = not requireAMDConfirm or amdConfirmed

// ---------------------------------------------------------------------
// NQ / ES / YM - session/block/redistribution/FVG state via security
// ---------------------------------------------------------------------
[nqBH, nqBL, nqPBH, nqPBL, nqSH, nqSL, nqPSH, nqPSL, nqTO, nqRole, nqIsBullD, nqIsBearD, nqDistExtHigh, nqDistExtLow, nqFvgLevel, nqFvgFilled, nqClose] = request.security(nqSymbol, timeframe.period, f_sessionBlockState(distMult))
[esBH, esBL, esPBH, esPBL, esSH, esSL, esPSH, esPSL, esTO, esRole, esIsBullD, esIsBearD, esDistExtHigh, esDistExtLow, esFvgLevel, esFvgFilled, esClose] = request.security(esSymbol, timeframe.period, f_sessionBlockState(distMult))
[ymBH, ymBL, ymPBH, ymPBL, ymSH, ymSL, ymPSH, ymPSL, ymTO, ymRole, ymIsBullD, ymIsBearD, ymDistExtHigh, ymDistExtLow, ymFvgLevel, ymFvgFilled, ymClose] = request.security(ymSymbol, timeframe.period, f_sessionBlockState(distMult))

// ---------------------------------------------------------------------
// FOCAL POINT: 90-MIN BLOCK
// ---------------------------------------------------------------------
nqBlockSweptHigh = not na(nqPBH) and nqBH > nqPBH
nqBlockSweptLow  = not na(nqPBL) and nqBL < nqPBL
esBlockSweptHigh = not na(esPBH) and esBH > esPBH
esBlockSweptLow  = not na(esPBL) and esBL < esPBL
ymBlockSweptHigh = not na(ymPBH) and ymBH > ymPBH
ymBlockSweptLow  = not na(ymPBL) and ymBL < ymPBL

blkHighSMT = use90Block and f_eval3(nqBlockSweptHigh, esBlockSweptHigh, ymBlockSweptHigh)
blkLowSMT  = use90Block and f_eval3(nqBlockSweptLow,  esBlockSweptLow,  ymBlockSweptLow)

// ---------------------------------------------------------------------
// FOCAL POINT: SESSION
// ---------------------------------------------------------------------
nqSessSweptHigh = not na(nqPSH) and nqSH > nqPSH
nqSessSweptLow  = not na(nqPSL) and nqSL < nqPSL
esSessSweptHigh = not na(esPSH) and esSH > esPSH
esSessSweptLow  = not na(esPSL) and esSL < esPSL
ymSessSweptHigh = not na(ymPSH) and ymSH > ymPSH
ymSessSweptLow  = not na(ymPSL) and ymSL < ymPSL

sesHighSMT = useSession and f_eval3(nqSessSweptHigh, esSessSweptHigh, ymSessSweptHigh)
sesLowSMT  = useSession and f_eval3(nqSessSweptLow,  esSessSweptLow,  ymSessSweptLow)

// ---------------------------------------------------------------------
// FOCAL POINT: MONTHLY / WEEKLY / DAILY
// ---------------------------------------------------------------------
[nqMoH, nqMoL, nqMoHP, nqMoLP] = request.security(nqSymbol, "M", [high, low, high[1], low[1]])
[esMoH, esMoL, esMoHP, esMoLP] = request.security(esSymbol, "M", [high, low, high[1], low[1]])
[ymMoH, ymMoL, ymMoHP, ymMoLP] = request.security(ymSymbol, "M", [high, low, high[1], low[1]])

[nqWkH, nqWkL, nqWkHP, nqWkLP] = request.security(nqSymbol, "W", [high, low, high[1], low[1]])
[esWkH, esWkL, esWkHP, esWkLP] = request.security(esSymbol, "W", [high, low, high[1], low[1]])
[ymWkH, ymWkL, ymWkHP, ymWkLP] = request.security(ymSymbol, "W", [high, low, high[1], low[1]])

[nqDyH, nqDyL, nqDyHP, nqDyLP] = request.security(nqSymbol, "D", [high, low, high[1], low[1]])
[esDyH, esDyL, esDyHP, esDyLP] = request.security(esSymbol, "D", [high, low, high[1], low[1]])
[ymDyH, ymDyL, ymDyHP, ymDyLP] = request.security(ymSymbol, "D", [high, low, high[1], low[1]])

nqMoSweptHigh = nqMoH > nqMoHP
nqMoSweptLow  = nqMoL < nqMoLP
esMoSweptHigh = esMoH > esMoHP
esMoSweptLow  = esMoL < esMoLP
ymMoSweptHigh = ymMoH > ymMoHP
ymMoSweptLow  = ymMoL < ymMoLP
moHighSMT = useMonthly and f_eval3(nqMoSweptHigh, esMoSweptHigh, ymMoSweptHigh)
moLowSMT  = useMonthly and f_eval3(nqMoSweptLow,  esMoSweptLow,  ymMoSweptLow)

nqWkSweptHigh = nqWkH > nqWkHP
nqWkSweptLow  = nqWkL < nqWkLP
esWkSweptHigh = esWkH > esWkHP
esWkSweptLow  = esWkL < esWkLP
ymWkSweptHigh = ymWkH > ymWkHP
ymWkSweptLow  = ymWkL < ymWkLP
wkHighSMT = useWeekly and f_eval3(nqWkSweptHigh, esWkSweptHigh, ymWkSweptHigh)
wkLowSMT  = useWeekly and f_eval3(nqWkSweptLow,  esWkSweptLow,  ymWkSweptLow)

nqDySweptHigh = nqDyH > nqDyHP
nqDySweptLow  = nqDyL < nqDyLP
esDySweptHigh = esDyH > esDyHP
esDySweptLow  = esDyL < esDyLP
ymDySweptHigh = ymDyH > ymDyHP
ymDySweptLow  = ymDyL < ymDyLP
dyHighSMT = useDaily and f_eval3(nqDySweptHigh, esDySweptHigh, ymDySweptHigh)
dyLowSMT  = useDaily and f_eval3(nqDySweptLow,  esDySweptLow,  ymDySweptLow)

// ---------------------------------------------------------------------
// INTRADAY MULTI-TIMEFRAME SMT
// ---------------------------------------------------------------------
f_tfSwept(sym, tf) =>
    [h1, l1, h2, l2] = request.security(sym, tf, [high[1], low[1], high[2], low[2]])
    madeHH = h1 > h2
    madeLL = l1 < l2
    [madeHH, madeLL]

[nq90HH, nq90LL] = f_tfSwept(nqSymbol, tf1)
[es90HH, es90LL] = f_tfSwept(esSymbol, tf1)
[ym90HH, ym90LL] = f_tfSwept(ymSymbol, tf1)
tf90HighSMT = useIntraday and f_eval3(nq90HH, es90HH, ym90HH)
tf90LowSMT  = useIntraday and f_eval3(nq90LL, es90LL, ym90LL)

[nq60HH, nq60LL] = f_tfSwept(nqSymbol, tf2)
[es60HH, es60LL] = f_tfSwept(esSymbol, tf2)
[ym60HH, ym60LL] = f_tfSwept(ymSymbol, tf2)
tf60HighSMT = useIntraday and f_eval3(nq60HH, es60HH, ym60HH)
tf60LowSMT  = useIntraday and f_eval3(nq60LL, es60LL, ym60LL)

[nq15HH, nq15LL] = f_tfSwept(nqSymbol, tf3)
[es15HH, es15LL] = f_tfSwept(esSymbol, tf3)
[ym15HH, ym15LL] = f_tfSwept(ymSymbol, tf3)
tf15HighSMT = useIntraday and f_eval3(nq15HH, es15HH, ym15HH)
tf15LowSMT  = useIntraday and f_eval3(nq15LL, es15LL, ym15LL)

[nq5HH, nq5LL] = f_tfSwept(nqSymbol, tf4)
[es5HH, es5LL] = f_tfSwept(esSymbol, tf4)
[ym5HH, ym5LL] = f_tfSwept(ymSymbol, tf4)
tf5HighSMT = useIntraday and f_eval3(nq5HH, es5HH, ym5HH)
tf5LowSMT  = useIntraday and f_eval3(nq5LL, es5LL, ym5LL)

[nq1HH, nq1LL] = f_tfSwept(nqSymbol, tf5)
[es1HH, es1LL] = f_tfSwept(esSymbol, tf5)
[ym1HH, ym1LL] = f_tfSwept(ymSymbol, tf5)
tf1HighSMT = useIntraday and f_eval3(nq1HH, es1HH, ym1HH)
tf1LowSMT  = useIntraday and f_eval3(nq1LL, es1LL, ym1LL)

// ---------------------------------------------------------------------
// RE-DISTRIBUTION (RETRACEMENT ZONE) SMT
// ---------------------------------------------------------------------
f_retraceRatio(trueOpenSym, distExtHighSym, distExtLowSym, isBullDSym, isBearDSym, closeSym) =>
    isBullDSym and not na(distExtHighSym) ? (distExtHighSym - closeSym) / (distExtHighSym - trueOpenSym) : isBearDSym and not na(distExtLowSym) ? (closeSym - distExtLowSym) / (trueOpenSym - distExtLowSym) : na

nqRetrace = f_retraceRatio(nqTO, nqDistExtHigh, nqDistExtLow, nqIsBullD, nqIsBearD, nqClose)
esRetrace = f_retraceRatio(esTO, esDistExtHigh, esDistExtLow, esIsBullD, esIsBearD, esClose)
ymRetrace = f_retraceRatio(ymTO, ymDistExtHigh, ymDistExtLow, ymIsBullD, ymIsBearD, ymClose)

nqInZone = not na(nqRetrace) and nqRetrace >= redisLow and nqRetrace <= redisHigh
esInZone = not na(esRetrace) and esRetrace >= redisLow and esRetrace <= redisHigh
ymInZone = not na(ymRetrace) and ymRetrace >= redisLow and ymRetrace <= redisHigh

redisSMT = useRedis and f_eval3(nqInZone, esInZone, ymInZone)

// ---------------------------------------------------------------------
// FVG SMT (fill status of the first FVG in the current Distribution leg)
// ---------------------------------------------------------------------
nqHasFVG = not na(nqFvgLevel)
esHasFVG = not na(esFvgLevel)
ymHasFVG = not na(ymFvgLevel)
allHaveFVG = nqHasFVG and esHasFVG and ymHasFVG

fvgSMT = useFVGSMT and allHaveFVG and f_eval3(nqFvgFilled, esFvgFilled, ymFvgFilled)

// ---------------------------------------------------------------------
// OVERALL / ALERTS
// ---------------------------------------------------------------------
anyRawSMT = moHighSMT or moLowSMT or wkHighSMT or wkLowSMT or dyHighSMT or dyLowSMT or blkHighSMT or blkLowSMT or sesHighSMT or sesLowSMT or tf90HighSMT or tf90LowSMT or tf60HighSMT or tf60LowSMT or tf15HighSMT or tf15LowSMT or tf5HighSMT or tf5LowSMT or tf1HighSMT or tf1LowSMT or redisSMT or fvgSMT

anyConfirmedSMT = anyRawSMT and gatePass

alertcondition(anyConfirmedSMT, title = "LMR SMT Confirmed", message = "LMR SMT: divergence confirmed against AMD Distribution")
alertcondition(anyRawSMT, title = "LMR SMT Raw (any)", message = "LMR SMT: raw structural divergence detected")

// ---------------------------------------------------------------------
// TABLE
// ---------------------------------------------------------------------
f_row(t, r, lbl, active, flagTxt) =>
    stateColor = not active ? color.gray : bearColor
    table.cell(t, 0, r, lbl, text_color = color.white, text_size = size.tiny)
    table.cell(t, 1, r, active ? flagTxt : "-", text_color = stateColor, text_size = size.tiny)

if showTable and barstate.islast
    tbl = table.new(position.bottom_right, 2, 26, bgcolor = color.new(color.black, 15), border_color = color.gray, border_width = 1)

    table.cell(tbl, 0, 0, "LMR SMT (Focal)", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.tiny)
    table.cell(tbl, 1, 0, "NQ/ES/YM", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.tiny)

    table.cell(tbl, 0, 1, "AMD Gate (" + amdDirection + ")", text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 1, 1, amdConfirmed ? "ACTIVE" : "waiting", text_color = amdConfirmed ? bullColor : color.gray, text_size = size.tiny)

    f_row(tbl, 2,  "Monthly High",   useMonthly, f_flagText(nqMoSweptHigh, esMoSweptHigh, ymMoSweptHigh))
    f_row(tbl, 3,  "Monthly Low",    useMonthly, f_flagText(nqMoSweptLow,  esMoSweptLow,  ymMoSweptLow))
    f_row(tbl, 4,  "Weekly High",    useWeekly,  f_flagText(nqWkSweptHigh, esWkSweptHigh, ymWkSweptHigh))
    f_row(tbl, 5,  "Weekly Low",     useWeekly,  f_flagText(nqWkSweptLow,  esWkSweptLow,  ymWkSweptLow))
    f_row(tbl, 6,  "Daily High",     useDaily,   f_flagText(nqDySweptHigh, esDySweptHigh, ymDySweptHigh))
    f_row(tbl, 7,  "Daily Low",      useDaily,   f_flagText(nqDySweptLow,  esDySweptLow,  ymDySweptLow))
    f_row(tbl, 8,  "90-Min Block Hi",use90Block, f_flagText(nqBlockSweptHigh, esBlockSweptHigh, ymBlockSweptHigh))
    f_row(tbl, 9,  "90-Min Block Lo",use90Block, f_flagText(nqBlockSweptLow,  esBlockSweptLow,  ymBlockSweptLow))
    f_row(tbl, 10, "Session High",   useSession, f_flagText(nqSessSweptHigh, esSessSweptHigh, ymSessSweptHigh))
    f_row(tbl, 11, "Session Low",    useSession, f_flagText(nqSessSweptLow,  esSessSweptLow,  ymSessSweptLow))
    f_row(tbl, 12, "TF " + tf1 + "m High", useIntraday, f_flagText(nq90HH, es90HH, ym90HH))
    f_row(tbl, 13, "TF " + tf1 + "m Low",  useIntraday, f_flagText(nq90LL, es90LL, ym90LL))
    f_row(tbl, 14, "TF " + tf2 + "m High", useIntraday, f_flagText(nq60HH, es60HH, ym60HH))
    f_row(tbl, 15, "TF " + tf2 + "m Low",  useIntraday, f_flagText(nq60LL, es60LL, ym60LL))
    f_row(tbl, 16, "TF " + tf3 + "m High", useIntraday, f_flagText(nq15HH, es15HH, ym15HH))
    f_row(tbl, 17, "TF " + tf3 + "m Low",  useIntraday, f_flagText(nq15LL, es15LL, ym15LL))
    f_row(tbl, 18, "TF " + tf4 + "m High", useIntraday, f_flagText(nq5HH, es5HH, ym5HH))
    f_row(tbl, 19, "TF " + tf4 + "m Low",  useIntraday, f_flagText(nq5LL, es5LL, ym5LL))
    f_row(tbl, 20, "TF " + tf5 + "m High", useIntraday, f_flagText(nq1HH, es1HH, ym1HH))
    f_row(tbl, 21, "TF " + tf5 + "m Low",  useIntraday, f_flagText(nq1LL, es1LL, ym1LL))
    f_row(tbl, 22, "Re-Distribution",useRedis,   f_flagText(nqInZone, esInZone, ymInZone))
    f_row(tbl, 23, "FVG Filled",     useFVGSMT and allHaveFVG, f_flagText(nqFvgFilled, esFvgFilled, ymFvgFilled))

    readyBg = anyConfirmedSMT ? color.new(color.green, 55) : color.new(color.gray, 60)
    table.cell(tbl, 0, 24, "SMT CONFIRMED", text_color = color.white, bgcolor = readyBg, text_size = size.tiny)
    table.cell(tbl, 1, 24, anyConfirmedSMT ? "YES" : "no", text_color = anyConfirmedSMT ? bullColor : color.orange, bgcolor = readyBg, text_size = size.tiny)
    table.cell(tbl, 0, 25, "Raw SMT (any)", text_color = color.white, text_size = size.tiny)
    table.cell(tbl, 1, 25, anyRawSMT ? "YES" : "no", text_color = anyRawSMT ? bearColor : color.gray, text_size = size.tiny)
