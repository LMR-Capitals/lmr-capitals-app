//@version=6
indicator("LMR ICT Everything ", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ════════════════════════════════════════════════════════════════════════════════════════════════
// GLOBAL SETTINGS
// ════════════════════════════════════════════════════════════════════════════════════════════════
i_timezone  = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "America/Los_Angeles", "Europe/London", "Asia/Tokyo", "Asia/Hong_Kong", "Asia/Singapore", "Australia/Sydney"], group="GLOBAL SETTINGS", tooltip="Select your timezone")
i_day_start = input.string("18:00 NY Open", "Day Start", options=["00:00 Midnight", "18:00 NY Open"], group="GLOBAL SETTINGS", tooltip="00:00 = Midnight to Midnight\n18:00 = 6PM to 6PM (futures style)")
i_hide_above = input.string("60", "Hide Above TF", options=["5", "15", "30", "60", "240", "1440"], group="GLOBAL SETTINGS", tooltip="Hide indicator on timeframes above this (minutes)")

bool use_midnight = i_day_start == "00:00 Midnight"
int hide_tf = math.round(str.tonumber(i_hide_above))

