i_eq_range       = input.string("Weekly", "Range", options=["Daily", "Weekly", "Monthly"], inline="eq0", group="EQUILIBRIUM / PREMIUM / DISCOUNT", tooltip="Range used for the 50% Equilibrium level and Premium/Discount zones")
i_eq_color       = input.color(color.gray, "EQ Line", inline="eq1", group="EQUILIBRIUM / PREMIUM / DISCOUNT")
i_premium_color  = input.color(color.new(color.red, 92), "Premium", inline="eq1", group="EQUILIBRIUM / PREMIUM / DISCOUNT")
i_discount_color = input.color(color.new(color.green, 92), "Discount", inline="eq1", group="EQUILIBRIUM / PREMIUM / DISCOUNT")

// ════════════════════════════════════════════════════════════════════════════
// SESSION BOXES
// ════════════════════════════════════════════════════════════════════════════

// --- MASTER TOGGLE ---
show_sb_all = input.bool(true, "Show Session Boxes", group="Session Boxes", tooltip="ⓘ Master toggle for all Session Boxes\n\n• ASIAN: 20:00 - 00:00\n• LONDON: 01:30 - 05:00\n• NY AM: 08:30 - 12:00\n• NY PM: 13:30 - 16:00")
show_sb_lbl = input.bool(true, "Show Labels", inline="sblbl", group="Session Boxes")
sb_lbl_size = input.string("Small", "", options=["Tiny", "Small", "Normal", "Large"], inline="sblbl", group="Session Boxes")

// --- ASIAN ---
sb1_en = input.bool(true, "", inline="sb1", group="Session Boxes", tooltip="ⓘ ASIAN Session\n20:00 - 00:00 ET")
sb1_n = input.string("ASIAN", "", inline="sb1", group="Session Boxes")
sb1_sess = input.session("2000-0000", "", inline="sb1", group="Session Boxes")
sb1_bg = input.color(color.new(#9C27B0, 85), "", inline="sb1", group="Session Boxes")
sb1_br = input.color(color.new(#9C27B0, 50), "", inline="sb1", group="Session Boxes")

// --- LONDON ---
sb2_en = input.bool(true, "", inline="sb2", group="Session Boxes", tooltip="ⓘ LONDON Session\n01:30 - 05:00 ET")
sb2_n = input.string("LONDON", "", inline="sb2", group="Session Boxes")
sb2_sess = input.session("0130-0500", "", inline="sb2", group="Session Boxes")
sb2_bg = input.color(color.new(#2196F3, 85), "", inline="sb2", group="Session Boxes")
sb2_br = input.color(color.new(#2196F3, 50), "", inline="sb2", group="Session Boxes")

// --- NY AM ---
sb3_en = input.bool(true, "", inline="sb3", group="Session Boxes", tooltip="ⓘ NY AM Session\n08:30 - 12:00 ET")
sb3_n = input.string("NY AM", "", inline="sb3", group="Session Boxes")
sb3_sess = input.session("0830-1200", "", inline="sb3", group="Session Boxes")
sb3_bg = input.color(color.new(#4CAF50, 85), "", inline="sb3", group="Session Boxes")
sb3_br = input.color(color.new(#4CAF50, 50), "", inline="sb3", group="Session Boxes")

// --- NY PM ---
sb4_en = input.bool(true, "", inline="sb4", group="Session Boxes", tooltip="ⓘ NY PM Session\n13:30 - 16:00 ET")
sb4_n = input.string("NY PM", "", inline="sb4", group="Session Boxes")
sb4_sess = input.session("1330-1600", "", inline="sb4", group="Session Boxes")
sb4_bg = input.color(color.new(#FF9800, 85), "", inline="sb4", group="Session Boxes")
sb4_br = input.color(color.new(#FF9800, 50), "", inline="sb4", group="Session Boxes")

// --- VARIABLES ---
var float sb1_h = na, var float sb1_l = na, var int sb1_st = na, var box sb1_box = na, var bool sb1_on = false
var float sb2_h = na, var float sb2_l = na, var int sb2_st = na, var box sb2_box = na, var bool sb2_on = false
var float sb3_h = na, var float sb3_l = na, var int sb3_st = na, var box sb3_box = na, var bool sb3_on = false
var float sb4_h = na, var float sb4_l = na, var int sb4_st = na, var box sb4_box = na, var bool sb4_on = false

// --- HELPER FUNCTIONS ---
getSBSize(string s) => 
    switch s
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        => size.small

getSessionStart(string sess) =>
    int sh = math.floor(str.tonumber(str.substring(sess, 0, 2)))
    int sm = math.floor(str.tonumber(str.substring(sess, 2, 4)))
    [sh, sm]

getSessionEnd(string sess) =>
    int eh = math.floor(str.tonumber(str.substring(sess, 5, 7)))
    int em = math.floor(str.tonumber(str.substring(sess, 7, 9)))
    [eh, em]

isInSB(int sh, int sm, int eh, int em, int h, int m) =>
    int st = sh * 60 + sm
    int en = eh * 60 + em
    int cu = h * 60 + m
    en < st ? (cu >= st or cu < en) : (cu >= st and cu < en)

isSBStart(int sh, int sm, int h, int m) => h == sh and m == sm
isSBEnd(int eh, int em, int h, int m) => h == eh and m == em

drawSBLabel(int st_idx, float hi, string name, color col) =>
    if show_sb_lbl
        label.new(st_idx + math.round((bar_index - st_idx) / 2), hi, name, 
             color=color.new(color.white, 100), textcolor=col, 
             style=label.style_label_down, size=getSBSize(sb_lbl_size))

// --- PARSE SESSION TIMES ---
[sb1_sh, sb1_sm] = getSessionStart(sb1_sess)
[sb1_eh, sb1_em] = getSessionEnd(sb1_sess)
[sb2_sh, sb2_sm] = getSessionStart(sb2_sess)
[sb2_eh, sb2_em] = getSessionEnd(sb2_sess)
[sb3_sh, sb3_sm] = getSessionStart(sb3_sess)
[sb3_eh, sb3_em] = getSessionEnd(sb3_sess)
[sb4_sh, sb4_sm] = getSessionStart(sb4_sess)
[sb4_eh, sb4_em] = getSessionEnd(sb4_sess)

// --- LOGIC ---
if show_sb_all
    int sb_h = hour(time, "America/New_York")
    int sb_m = minute(time, "America/New_York")

    // ASIAN
    if sb1_en
        if isSBStart(sb1_sh, sb1_sm, sb_h, sb_m) and not sb1_on
            sb1_on := true
            sb1_h := high
            sb1_l := low
            sb1_st := bar_index
            sb1_box := box.new(bar_index, high, bar_index, low, bgcolor=sb1_bg, border_color=sb1_br)
        if sb1_on and isInSB(sb1_sh, sb1_sm, sb1_eh, sb1_em, sb_h, sb_m)
            sb1_h := math.max(sb1_h, high)
            sb1_l := math.min(sb1_l, low)
            if not na(sb1_box)
                box.set_top(sb1_box, sb1_h)
                box.set_bottom(sb1_box, sb1_l)
                box.set_right(sb1_box, bar_index)
        if isSBEnd(sb1_eh, sb1_em, sb_h, sb_m) and sb1_on
            sb1_on := false
            drawSBLabel(sb1_st, sb1_h, sb1_n, sb1_br)

    // LONDON
    if sb2_en
        if isSBStart(sb2_sh, sb2_sm, sb_h, sb_m) and not sb2_on
            sb2_on := true
            sb2_h := high
            sb2_l := low
            sb2_st := bar_index
            sb2_box := box.new(bar_index, high, bar_index, low, bgcolor=sb2_bg, border_color=sb2_br)
        if sb2_on and isInSB(sb2_sh, sb2_sm, sb2_eh, sb2_em, sb_h, sb_m)
            sb2_h := math.max(sb2_h, high)
            sb2_l := math.min(sb2_l, low)
            if not na(sb2_box)
                box.set_top(sb2_box, sb2_h)
                box.set_bottom(sb2_box, sb2_l)
                box.set_right(sb2_box, bar_index)
        if isSBEnd(sb2_eh, sb2_em, sb_h, sb_m) and sb2_on
            sb2_on := false
            drawSBLabel(sb2_st, sb2_h, sb2_n, sb2_br)

    // NY AM
    if sb3_en
        if isSBStart(sb3_sh, sb3_sm, sb_h, sb_m) and not sb3_on
            sb3_on := true
            sb3_h := high
            sb3_l := low
            sb3_st := bar_index
            sb3_box := box.new(bar_index, high, bar_index, low, bgcolor=sb3_bg, border_color=sb3_br)
        if sb3_on and isInSB(sb3_sh, sb3_sm, sb3_eh, sb3_em, sb_h, sb_m)
            sb3_h := math.max(sb3_h, high)
            sb3_l := math.min(sb3_l, low)
            if not na(sb3_box)
                box.set_top(sb3_box, sb3_h)
                box.set_bottom(sb3_box, sb3_l)
                box.set_right(sb3_box, bar_index)
        if isSBEnd(sb3_eh, sb3_em, sb_h, sb_m) and sb3_on
            sb3_on := false
            drawSBLabel(sb3_st, sb3_h, sb3_n, sb3_br)

    // NY PM
    if sb4_en
        if isSBStart(sb4_sh, sb4_sm, sb_h, sb_m) and not sb4_on
            sb4_on := true
            sb4_h := high
            sb4_l := low
            sb4_st := bar_index
            sb4_box := box.new(bar_index, high, bar_index, low, bgcolor=sb4_bg, border_color=sb4_br)
        if sb4_on and isInSB(sb4_sh, sb4_sm, sb4_eh, sb4_em, sb_h, sb_m)
            sb4_h := math.max(sb4_h, high)
            sb4_l := math.min(sb4_l, low)
            if not na(sb4_box)
                box.set_top(sb4_box, sb4_h)
                box.set_bottom(sb4_box, sb4_l)
                box.set_right(sb4_box, bar_index)
        if isSBEnd(sb4_eh, sb4_em, sb_h, sb_m) and sb4_on
            sb4_on := false
            drawSBLabel(sb4_st, sb4_h, sb4_n, sb4_br)
// ════════════════════════════════════════════════════════════════════════════════════════════════
