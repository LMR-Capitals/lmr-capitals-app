# Add these build-time values to the project-root .env.local or hosting settings.
# Only public configuration belongs in VITE_* variables. Never add Stripe or service-role secrets.
VITE_SUPABASE_URL=https://agrvylclhvxyevsmmexf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-existing-publishable-key
VITE_MEMBER_LEGAL_APPROVED=false
# Free registration can be approved separately without enabling live payments.
VITE_ACCOUNT_POLICIES_APPROVED=false
VITE_MEMBER_LEGAL_VERSION=
VITE_MEMBER_TERMS_URL=
VITE_MEMBER_PRIVACY_URL=

# Supabase Edge Function secrets (configure on the server, NEVER prefix with VITE_):
# APP_URL=https://your-confirmed-app-domain
# ALLOWED_APP_ORIGINS=https://your-confirmed-preview-domain
# STRIPE_SECRET_KEY=<existing secret>
# STRIPE_WEBHOOK_SECRET=<existing webhook secret>
# STRIPE_PRICE_MONTHLY=<existing configured price ID>
# STRIPE_PRICE_YEARLY=<existing configured price ID>
# MEMBER_LEGAL_APPROVED=false
# MEMBER_LEGAL_VERSION=<same approved version as frontend>
